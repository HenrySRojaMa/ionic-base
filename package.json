{
  "name": "ionic-base",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:check": "ng build && node scripts/check-prod-bundle.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" \"*.{js,mjs,json,md}\"",
    "cap:sync": "ng build && cap sync",
    "cap:android": "ng build && cap sync android && cap open android",
    "cap:ios": "ng build && cap sync ios && cap open ios"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@ionic/angular": "^9.0.8",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
