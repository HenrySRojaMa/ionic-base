# Todos los archivos de texto se guardan con saltos de línea LF en el repositorio,
# sin importar el sistema operativo de quien hace el commit.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary

# Los scripts de Windows (gradlew.bat del proyecto Android) necesitan CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
